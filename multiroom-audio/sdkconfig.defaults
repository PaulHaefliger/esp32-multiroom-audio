# Applied only when no sdkconfig exists (fresh workspace / after fullclean).

# Flash + partitions (app is ~1.5 MB with BT + WiFi)
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"

# Classic Bluetooth, Bluedroid, A2DP sink
CONFIG_BT_ENABLED=y
CONFIG_BTDM_CTRL_MODE_BLE_ONLY=n
CONFIG_BTDM_CTRL_MODE_BR_EDR_ONLY=y
CONFIG_BTDM_CTRL_MODE_BTDM=n
CONFIG_BT_BLUEDROID_ENABLED=y
CONFIG_BT_CLASSIC_ENABLED=y
CONFIG_BT_A2DP_ENABLE=y

# 240 MHz CPU. WiFi TX buffers capped at 16 (~26 KB worst case): each is
# malloc'd while queued, and 64 exhausted the heap during a WiFi stall
# (Bluedroid then asserted on calloc failure and the board rebooted).
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y
CONFIG_ESP_WIFI_DYNAMIC_TX_BUFFER_NUM=16
CONFIG_ESP_COEX_SW_COEXIST_ENABLE=y
